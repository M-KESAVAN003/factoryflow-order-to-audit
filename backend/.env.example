# Application
APP_NAME="FactoryFlow API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Neon / Managed PostgreSQL Connection String
# Example: postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require

# SQLAlchemy Pool Settings (Neon serverless PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_ECHO=false

# Security / JWT (Render accepts SECRET_KEY; local dev accepts JWT_SECRET_KEY)
SECRET_KEY=replace-with-random-secret-minimum-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowlist (set to deployed Vercel URL in production)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Demo Seed Accounts (enable ONLY in isolated/demo environments, never production)
DEMO_SEED_ENABLED=false
DEMO_SEED_PASSWORD=FactoryFlow!2026
